enum CaseDocumentRevisionStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SUPERSEDED
}

model CaseDocumentRevision {
  id                   String                     @id @default(uuid()) @db.Uuid
  caseDocumentId       String                     @db.Uuid
  revisionNumber       Int
  templateCode         String
  templateVersion      Int
  templateSourceHash   String
  questionnaireVersion Int
  sourceDataHash       String
  sourceData           Json
  status               CaseDocumentRevisionStatus @default(DRAFT)
  createdByUserId      String                     @db.Uuid
  submittedByUserId    String?                    @db.Uuid
  submittedAt          DateTime?
  reviewedByUserId     String?                    @db.Uuid
  reviewNote           String?
  reviewedAt           DateTime?
  approvedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  caseDocument CaseDocument @relation(fields: [caseDocumentId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdBy    User         @relation("CaseDocumentRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  submittedBy  User?        @relation("CaseDocumentRevisionSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  reviewedBy   User?        @relation("CaseDocumentRevisionReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([caseDocumentId, revisionNumber])
  @@index([caseDocumentId, status, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([submittedByUserId, submittedAt])
  @@index([reviewedByUserId, reviewedAt])
}
