generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ClientCaseStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum QuestionnaireStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  NEW
  WORKING
  DONE
}

enum CaseDocumentStatus {
  WAITING_DATA
  DRAFT
  READY_FOR_REVIEW
  SENT_FOR_REVIEW
  REVIEWED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String?    @unique
  phone       String?    @unique
  displayName String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roles            UserRole[]
  clientCases      ClientCase[]      @relation("ClientCases")
  assignedCases    ClientCase[]      @relation("AssignedLawyerCases")
  authIdentities   AuthIdentity[]
  assignedTasks    CaseTask[]        @relation("AssignedTasks")
  taskStatusEvents TaskStatusEvent[] @relation("TaskStatusEventActors")
}

model AuthIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  provider  String
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features    PlanFeature[]
  clientCases ClientCase[]
}

model Feature {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans PlanFeature[]
}

model PlanFeature {
  planId    String   @db.Uuid
  featureId String   @db.Uuid
  createdAt DateTime @default(now())

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
}

model CaseStage {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  sortOrder   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientCases ClientCase[]

  @@index([sortOrder])
}

model ClientCase {
  id               String           @id @default(uuid()) @db.Uuid
  caseNumber       String           @unique
  clientId         String           @db.Uuid
  planId           String           @db.Uuid
  stageId          String           @db.Uuid
  assignedLawyerId String?          @db.Uuid
  status           ClientCaseStatus @default(DRAFT)
  openedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  client            User                   @relation("ClientCases", fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedLawyer    User?                  @relation("AssignedLawyerCases", fields: [assignedLawyerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  plan              Plan                   @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stage             CaseStage              @relation(fields: [stageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  questionnaire     CaseQuestionnaire?
  practicumProgress CasePracticumProgress?
  tasks             CaseTask[]
  documents         CaseDocument[]

  @@index([clientId])
  @@index([assignedLawyerId])
  @@index([planId])
  @@index([stageId])
  @@index([status])
}

model CaseQuestionnaire {
  clientCaseId        String              @id @db.Uuid
  schemaVersion       Int                 @default(1)
  status              QuestionnaireStatus @default(NOT_STARTED)
  answers             Json
  completedSectionIds String[]
  startedAt           DateTime?
  completedAt         DateTime?
  version             Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model CasePracticumProgress {
  clientCaseId       String   @id @db.Uuid
  completedLessonIds String[]
  startedAt          DateTime?
  completedAt        DateTime?
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model CaseTask {
  id           String     @id @default(uuid()) @db.Uuid
  clientCaseId String     @db.Uuid
  assigneeId   String     @db.Uuid
  title        String
  description  String?
  status       TaskStatus @default(NEW)
  dueAt        DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  clientCase ClientCase        @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignee   User              @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events     TaskStatusEvent[]

  @@index([clientCaseId])
  @@index([assigneeId])
  @@index([status])
  @@index([dueAt])
}

model TaskStatusEvent {
  id          String     @id @default(uuid()) @db.Uuid
  taskId      String     @db.Uuid
  actorUserId String     @db.Uuid
  fromStatus  TaskStatus
  toStatus    TaskStatus
  createdAt   DateTime   @default(now())

  task  CaseTask @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor User     @relation("TaskStatusEventActors", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([taskId, createdAt])
  @@index([actorUserId])
}

model CaseDocument {
  id              String             @id @default(uuid()) @db.Uuid
  clientCaseId    String             @db.Uuid
  documentCode    String
  status          CaseDocumentStatus @default(WAITING_DATA)
  regeneratedAt   DateTime?
  sentForReviewAt DateTime?
  reviewedAt      DateTime?
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([clientCaseId, documentCode])
  @@index([clientCaseId, status])
}
