generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ClientCaseStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum QuestionnaireStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PracticumProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

enum PracticumHomeworkStatus {
  NOT_STARTED
  DRAFT
  SUBMITTED
  IN_REVIEW
  CHANGES_REQUESTED
  ACCEPTED
}

enum PracticumHomeworkReviewDecision {
  CHANGES_REQUESTED
  ACCEPTED
}

enum TaskStatus {
  NEW
  WORKING
  DONE
}

enum CaseDocumentStatus {
  WAITING_DATA
  DRAFT
  READY_FOR_REVIEW
  SENT_FOR_REVIEW
  REVIEWED
}

enum StoredFileStatus {
  PENDING_UPLOAD
  PENDING_SCAN
  SCANNING
  READY
  QUARANTINED
  SCAN_FAILED
}

enum NotificationDeliveryChannel {
  EMAIL
}

enum NotificationDeliveryStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
}

enum PotentialClientLeadContactType {
  EMAIL
  PHONE
}

enum PotentialClientLeadStatus {
  NEW
  CONVERTED
  ARCHIVED
}

model User {
  id          String     @id @default(uuid()) @db.Uuid
  email       String?    @unique
  phone       String?
  displayName String?
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  roles                        UserRole[]
  clientCases                  ClientCase[]                      @relation("ClientCases")
  assignedCases                ClientCase[]                      @relation("AssignedLawyerCases")
  authIdentities               AuthIdentity[]
  securityEvents               UserSecurityEvent[]               @relation("UserSecurityEvents")
  assignedTasks                CaseTask[]                        @relation("AssignedTasks")
  taskStatusEvents             TaskStatusEvent[]                 @relation("TaskStatusEventActors")
  activityEvents               CaseActivityEvent[]               @relation("CaseActivityActors")
  notifications                Notification[]
  uploadedFiles                StoredFile[]                      @relation("StoredFileUploaders")
  practicumHomeworkSubmissions CasePracticumHomeworkRevision[]  @relation("PracticumHomeworkSubmitters")
  practicumHomeworkReviews     CasePracticumHomeworkRevision[]  @relation("PracticumHomeworkReviewers")
  practicumLessonMessages      CasePracticumLessonMessage[]     @relation("PracticumLessonMessageAuthors")
  practicumLessonReadStates    CasePracticumLessonReadState[]
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]
}

model UserRole {
  userId     String   @db.Uuid
  roleId     String   @db.Uuid
  assignedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model AuthIdentity {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  provider  String
  subject   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model UserSecurityEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  type      String
  createdAt DateTime @default(now())

  user User @relation("UserSecurityEvents", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  features    PlanFeature[]
  clientCases ClientCase[]
}

model Feature {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plans PlanFeature[]
}

model PlanFeature {
  planId    String   @db.Uuid
  featureId String   @db.Uuid
  createdAt DateTime @default(now())

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([planId, featureId])
  @@index([featureId])
}

model CaseStage {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  name        String
  description String?
  sortOrder   Int
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  clientCases ClientCase[]

  @@index([sortOrder])
}

model ClientCase {
  id               String           @id @default(uuid()) @db.Uuid
  caseNumber       String           @unique
  clientId         String           @db.Uuid
  planId           String           @db.Uuid
  stageId          String           @db.Uuid
  assignedLawyerId String?          @db.Uuid
  status           ClientCaseStatus @default(DRAFT)
  openedAt         DateTime?
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  client         User      @relation("ClientCases", fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plan           Plan      @relation(fields: [planId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  stage          CaseStage @relation(fields: [stageId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  assignedLawyer User?     @relation("AssignedLawyerCases", fields: [assignedLawyerId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  questionnaire             CaseQuestionnaire?
  practicumProgress         CasePracticumProgress?
  practicumHomeworks        CasePracticumHomework[]
  practicumLessonMessages   CasePracticumLessonMessage[]
  practicumLessonReadStates CasePracticumLessonReadState[]
  tasks                     CaseTask[]
  documents                 CaseDocument[]
  activityEvents            CaseActivityEvent[]
  notifications             Notification[]
  storedFiles               StoredFile[]

  @@index([clientId])
  @@index([planId])
  @@index([stageId])
  @@index([assignedLawyerId])
  @@index([status])
}

model CaseQuestionnaire {
  clientCaseId        String              @id @db.Uuid
  schemaVersion       Int                 @default(1)
  status              QuestionnaireStatus @default(NOT_STARTED)
  answers             Json
  completedSectionIds String[]
  startedAt           DateTime?
  completedAt         DateTime?
  version             Int                 @default(1)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model CasePracticumProgress {
  clientCaseId       String                   @id @db.Uuid
  status             PracticumProgressStatus @default(NOT_STARTED)
  completedLessonIds String[]
  startedAt          DateTime?
  completedAt        DateTime?
  version            Int                      @default(1)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model CasePracticumHomework {
  id           String                  @id @default(uuid()) @db.Uuid
  clientCaseId String                  @db.Uuid
  lessonId     String
  status       PracticumHomeworkStatus @default(NOT_STARTED)
  draftText    String                  @default("")
  submittedAt  DateTime?
  reviewedAt   DateTime?
  version      Int                     @default(1)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  clientCase ClientCase                       @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  revisions  CasePracticumHomeworkRevision[]

  @@unique([clientCaseId, lessonId])
  @@index([clientCaseId, status, updatedAt])
  @@index([status, submittedAt])
}

model CasePracticumHomeworkRevision {
  id                String                            @id @default(uuid()) @db.Uuid
  homeworkId        String                            @db.Uuid
  revisionNumber    Int
  submittedByUserId String                            @db.Uuid
  answerText        String
  submittedAt       DateTime                          @default(now())
  reviewedByUserId  String?                           @db.Uuid
  reviewDecision    PracticumHomeworkReviewDecision?
  reviewComment     String?
  reviewedAt        DateTime?

  homework    CasePracticumHomework @relation(fields: [homeworkId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  submittedBy User                  @relation("PracticumHomeworkSubmitters", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reviewedBy  User?                 @relation("PracticumHomeworkReviewers", fields: [reviewedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([homeworkId, revisionNumber])
  @@index([homeworkId, submittedAt])
  @@index([submittedByUserId])
  @@index([reviewedByUserId, reviewedAt])
}

model CasePracticumLessonMessage {
  id           String   @id @default(uuid()) @db.Uuid
  clientCaseId String   @db.Uuid
  lessonId     String
  authorUserId String   @db.Uuid
  body         String
  createdAt    DateTime @default(now())

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author     User       @relation("PracticumLessonMessageAuthors", fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([clientCaseId, lessonId, createdAt])
  @@index([authorUserId, createdAt])
}

model CasePracticumLessonReadState {
  clientCaseId String   @db.Uuid
  lessonId     String
  userId       String   @db.Uuid
  lastReadAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@id([clientCaseId, lessonId, userId])
  @@index([userId, lastReadAt])
}

model CaseTask {
  id           String     @id @default(uuid()) @db.Uuid
  clientCaseId String     @db.Uuid
  assigneeId   String     @db.Uuid
  title        String
  description  String?
  status       TaskStatus @default(NEW)
  dueAt        DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  version      Int        @default(1)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assignee   User       @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  events     TaskStatusEvent[]

  @@index([clientCaseId])
  @@index([assigneeId, status, dueAt])
}

model TaskStatusEvent {
  id          String     @id @default(uuid()) @db.Uuid
  taskId      String     @db.Uuid
  actorUserId String     @db.Uuid
  fromStatus  TaskStatus
  toStatus    TaskStatus
  createdAt   DateTime   @default(now())

  task  CaseTask @relation(fields: [taskId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor User     @relation("TaskStatusEventActors", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([taskId, createdAt])
  @@index([actorUserId])
}

model CaseDocument {
  id              String             @id @default(uuid()) @db.Uuid
  clientCaseId    String             @db.Uuid
  documentCode    String
  status          CaseDocumentStatus @default(WAITING_DATA)
  regeneratedAt   DateTime?
  sentForReviewAt DateTime?
  reviewedAt      DateTime?
  version         Int                @default(1)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([clientCaseId, documentCode])
  @@index([clientCaseId, status])
}

model CaseActivityEvent {
  id           String   @id @default(uuid()) @db.Uuid
  clientCaseId String   @db.Uuid
  actorUserId  String?  @db.Uuid
  type         String
  metadata     Json?
  createdAt    DateTime @default(now())

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  actor      User?      @relation("CaseActivityActors", fields: [actorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([clientCaseId, createdAt])
  @@index([actorUserId])
  @@index([type])
}

model Notification {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  clientCaseId String?  @db.Uuid
  dedupeKey    String?
  type         String
  title        String
  body         String
  readAt       DateTime?
  createdAt    DateTime @default(now())

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  clientCase ClientCase?            @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  deliveries NotificationDelivery[]

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
  @@index([clientCaseId])
}

model NotificationDelivery {
  id                String                      @id @default(uuid()) @db.Uuid
  notificationId    String                      @db.Uuid
  channel           NotificationDeliveryChannel
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                         @default(0)
  nextAttemptAt     DateTime                    @default(now())
  leaseUntil        DateTime?
  leaseToken        String?                     @db.Uuid
  providerMessageId String?
  lastErrorCode     String?
  sentAt            DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([notificationId, channel])
  @@index([channel, status, nextAttemptAt])
  @@index([status, leaseUntil])
}

model StoredFile {
  id                String           @id @default(uuid()) @db.Uuid
  clientCaseId      String           @db.Uuid
  uploadedById      String?          @db.Uuid
  status            StoredFileStatus @default(PENDING_UPLOAD)
  storageProvider   String
  objectKey         String           @unique
  fileName          String
  mimeType          String
  sizeBytes         BigInt
  checksumSha256    String?
  scanAttemptCount  Int              @default(0)
  scanNextAttemptAt DateTime?
  scanLeaseUntil    DateTime?
  scanLeaseToken    String?          @db.Uuid
  scanProvider      String?
  scanLastErrorCode String?
  scannedAt         DateTime?
  quarantinedAt     DateTime?
  readyAt           DateTime?
  createdAt         DateTime         @default(now())

  clientCase ClientCase @relation(fields: [clientCaseId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  uploadedBy User?       @relation("StoredFileUploaders", fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([clientCaseId, status, createdAt])
  @@index([status, scanNextAttemptAt])
  @@index([status, scanLeaseUntil])
  @@index([uploadedById])
}

model PotentialClientLead {
  id           String                         @id @default(uuid()) @db.Uuid
  contactType  PotentialClientLeadContactType
  contactKey   String                         @unique
  email        String?
  phone        String?
  source       String                         @default("AUTH_GATE")
  status       PotentialClientLeadStatus      @default(NEW)
  attemptCount Int                            @default(1)
  firstSeenAt  DateTime                       @default(now())
  lastSeenAt   DateTime                       @default(now())
  createdAt    DateTime                       @default(now())
  updatedAt    DateTime                       @updatedAt

  @@index([status, lastSeenAt])
  @@index([contactType, lastSeenAt])
}
