DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Explicit guards for staging-only database verification/deploy tooling.
# These values must describe the same target encoded in DATABASE_URL.
IB_DB_TARGET="staging"
IB_STAGING_DATABASE_HOST="staging.pg.example.net"
IB_STAGING_DATABASE_NAME="iburo_staging"
IB_STAGING_DATABASE_USER="iburo_staging_user"
IB_STAGING_BETTER_AUTH_SCHEMA="public"

# Better Auth — generate a strong secret outside the repository.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="https://app.example.com"

# Yandex Cloud Postbox — use a dedicated service account/static key with postbox.sender.
YANDEX_POSTBOX_FROM_EMAIL="no-reply@example.com"
YANDEX_POSTBOX_ACCESS_KEY_ID="replace-with-postbox-static-key-id"
YANDEX_POSTBOX_SECRET_ACCESS_KEY="replace-with-postbox-static-key-secret"

# Private maintenance endpoint. Use an independent random secret (32+ chars).
IB_MAINTENANCE_SECRET="replace-with-an-independent-long-random-secret"
IB_STALE_UPLOAD_MAX_AGE_MINUTES="60"
IB_STALE_UPLOAD_BATCH_LIMIT="100"

# Yandex Object Storage — private bucket only.
IB_STORAGE_TARGET="staging"
IB_STAGING_STORAGE_BUCKET="private-iburo-staging-files"
IB_STAGING_STORAGE_ALLOWED_ORIGIN="https://staging-app.example.com"
YANDEX_STORAGE_BUCKET="private-iburo-staging-files"
YANDEX_STORAGE_ACCESS_KEY_ID="replace-with-service-account-static-key-id"
YANDEX_STORAGE_SECRET_ACCESS_KEY="replace-with-service-account-static-key-secret"
