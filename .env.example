# Runtime identity for isolated staging/Preview deployments.
# The initial Vercel Preview identity check requires this exact value.
# Keep IB_VERCEL_PREVIEW_BACKEND_CONFIRM unset during that first check so backendEnabled remains false.
IB_RUNTIME_TARGET="staging"

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Explicit guards for staging-only database verification/deploy tooling.
# These values must describe the same target encoded in DATABASE_URL.
IB_DB_TARGET="staging"
IB_STAGING_DATABASE_HOST="staging.pg.example.net"
IB_STAGING_DATABASE_NAME="iburo_staging"
IB_STAGING_DATABASE_USER="iburo_staging_user"
IB_STAGING_BETTER_AUTH_SCHEMA="public"

# Exact SHA-256 fingerprint of the reviewed prisma/migrations history.
# Obtain it with `npm run db:inspect:migrations` only after the authoritative DB baseline is resolved
# and the generated SQL has been manually reviewed. Leave empty until then.
IB_STAGING_MIGRATION_HISTORY_SHA256=""

# Mutation confirmations are intentionally empty by default.
# Set only for the single staging operation being executed.
IB_STAGING_MIGRATION_CONFIRM=""
IB_STAGING_REFERENCE_SEED_CONFIRM=""
IB_STAGING_DEMO_SEED_CONFIRM=""

# Guarded Better Auth -> internal AuthIdentity linking in staging only.
# Confirmation must be exactly LINK:<staging-database-name>:<IB_AUTH_LINK_USER_ID>.
IB_AUTH_LINK_USER_ID=""
IB_AUTH_LINK_SUBJECT=""
IB_AUTH_LINK_PROVIDER="better-auth"
IB_AUTH_LINK_CONFIRM=""

# Demo/investor routes under /app are fail-closed.
# Keep disabled in production. Set the exact value "enabled" only in an isolated preview/demo deployment.
IB_DEMO_PORTAL_MODE="disabled"

# Better Auth — generate a strong secret outside the repository.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="https://app.example.com"

# OpenAI Responses API for the server-side AI assistant.
OPENAI_API_KEY="replace-with-server-side-openai-api-key"
IB_AI_OPENAI_MODEL="gpt-5.6-terra"
IB_AI_OPENAI_REQUEST_TIMEOUT_MS="20000"
IB_AI_OPENAI_MAX_OUTPUT_TOKENS="1200"
IB_AI_RATE_LIMIT_PER_MINUTE="6"
IB_AI_RATE_LIMIT_PER_DAY="100"

# Active staging-only OpenAI provider smoke verification.
IB_AI_TARGET="staging"
IB_STAGING_OPENAI_MODEL="gpt-5.6-terra"
IB_STAGING_OPENAI_KEY_SHA256=""
IB_STAGING_AI_CONFIRM=""

# Staging HTTP authorization fixtures. Cookies must be short-lived staging sessions only.
IB_STAGING_BASE_URL="https://staging-app.example.com"
IB_STAGING_CLIENT_COOKIE=""
IB_STAGING_LAWYER_COOKIE=""
IB_STAGING_MANAGER_COOKIE=""
IB_STAGING_CLIENT_CASE_NUMBER="STAGE-CLIENT-001"
IB_STAGING_LAWYER_CASE_NUMBER="STAGE-LAWYER-001"
IB_STAGING_CLIENT_AI_CASE_NUMBER="STAGE-CLIENT-AI-001"
IB_STAGING_CLIENT_NO_AI_CASE_NUMBER="STAGE-CLIENT-NOAI-001"

# Active HTTP mutation E2E is intentionally disabled by default and requires a dedicated mutable staging case/task.
# Base confirmation format: MUTATE:<staging-host>. Private file upload has a second independent bucket confirmation.
IB_STAGING_MUTATION_TARGET="staging"
IB_STAGING_MUTATION_CONFIRM=""
IB_STAGING_MUTATION_CASE_NUMBER="STAGE-MUTATION-001"
IB_STAGING_MUTATION_TASK_ID=""
IB_STAGING_FILES_E2E="0"
IB_STAGING_PRIVATE_BUCKET_CONFIRM=""
IB_STAGING_OTHER_CLIENT_COOKIE=""
# Full CLEAN -> READY integration is a third explicit opt-in after scanner smoke verification.
# Confirmation format: SCAN:<staging-host>. Worker runs are bounded to 1-20; default 5.
IB_STAGING_FILE_SCAN_E2E="0"
IB_STAGING_FILE_SCAN_E2E_CONFIRM=""
IB_STAGING_FILE_SCAN_E2E_MAX_RUNS="5"

# Bitrix24 internal CRM integration. PostgreSQL remains the source of truth.
# Use a dedicated least-privilege incoming webhook owned by a service/integration user.
BITRIX24_PORTAL_ORIGIN="https://iburo-staging.bitrix24.ru"
IB_BITRIX24_ALLOWED_HOST="iburo-staging.bitrix24.ru"
BITRIX24_WEBHOOK_USER_ID="17"
BITRIX24_WEBHOOK_SECRET="replace-with-staging-bitrix24-webhook-secret"
BITRIX24_REQUEST_TIMEOUT_MS="10000"
# No CRM entity is assumed by the application. Configure the selected Deal/SPA entity explicitly.
BITRIX24_CASE_ENTITY_TYPE_ID=""
# Exact semantic-to-Bitrix field mapping. Only these four non-PII case values may be projected.
# Example shape only; replace field names with values verified on the staging portal.
# caseNumber=title,planCode=ufCrm128PlanCode,stageCode=ufCrm128StageCode,status=ufCrm128CaseStatus
BITRIX24_CASE_FIELD_MAP=""

# Active read-only staging Bitrix24 verification guard.
# SHA-256 is the lowercase hex digest of the exact staging webhook secret.
# Confirmation for the single verification run:
# BITRIX-VERIFY:<hostname>:<user-id>:<secret-sha256>
IB_BITRIX24_TARGET="staging"
IB_STAGING_BITRIX24_PORTAL_ORIGIN="https://iburo-staging.bitrix24.ru"
IB_STAGING_BITRIX24_WEBHOOK_USER_ID="17"
IB_STAGING_BITRIX24_WEBHOOK_SECRET_SHA256=""
IB_STAGING_BITRIX24_CONFIRM=""

# Yandex Cloud Postbox — use a dedicated staging sender and service account/static key with postbox.sender.
YANDEX_POSTBOX_FROM_EMAIL="no-reply-staging@example.com"
YANDEX_POSTBOX_ACCESS_KEY_ID="replace-with-staging-postbox-static-key-id"
YANDEX_POSTBOX_SECRET_ACCESS_KEY="replace-with-staging-postbox-static-key-secret"
YANDEX_POSTBOX_REQUEST_TIMEOUT_MS="10000"

# Active staging Postbox simulator verification guard.
IB_EMAIL_TARGET="staging"
IB_STAGING_POSTBOX_FROM_EMAIL="no-reply-staging@example.com"
IB_STAGING_POSTBOX_ACCESS_KEY_ID="replace-with-staging-postbox-static-key-id"
IB_STAGING_POSTBOX_CONFIRM=""

# Internal malware scanner service. This is a controlled HTTPS service, not a browser endpoint.
# Contract: POST /v1/scan-url with Bearer auth and JSON {sourceUrl,mimeType,sizeBytes};
# response must be exactly {"verdict":"CLEAN"} or {"verdict":"MALICIOUS"}.
# The application sends no file name, user id or case data to this service.
IB_FILE_SCANNER_ORIGIN="https://scanner-staging.example.com"
IB_FILE_SCANNER_SECRET="replace-with-an-independent-long-random-secret"
IB_FILE_SCANNER_REQUEST_TIMEOUT_MS="60000"

# Active staging malware-scanner smoke guard. The two fixture objects must already exist in the
# private staging bucket under the dedicated security-fixtures/file-scanner/ prefix.
# The verifier performs HEAD + local GET signing + scanner calls only; it never uploads/deletes/lists objects.
# SHA-256 is the lowercase hex digest of the exact staging scanner secret.
# Confirmation format:
# FILE-SCANNER-SMOKE:<scanner-hostname>:<staging-bucket>:<scanner-secret-sha256>
IB_FILE_SCANNER_TARGET="staging"
IB_STAGING_FILE_SCANNER_ORIGIN="https://scanner-staging.example.com"
IB_STAGING_FILE_SCANNER_SECRET_SHA256=""
IB_STAGING_FILE_SCANNER_CLEAN_OBJECT_KEY="security-fixtures/file-scanner/clean.txt"
IB_STAGING_FILE_SCANNER_MALICIOUS_OBJECT_KEY="security-fixtures/file-scanner/eicar.txt"
IB_STAGING_FILE_SCANNER_CONFIRM=""

# Private maintenance endpoints and provider-neutral scheduler runner.
# The base URL must be an HTTPS origin; HTTP is accepted only for loopback/local tests.
# No production scheduler is configured by these values alone.
IB_MAINTENANCE_SECRET="replace-with-an-independent-long-random-secret"
IB_MAINTENANCE_BASE_URL="https://app.example.com"
IB_MAINTENANCE_REQUEST_TIMEOUT_MS="15000"
IB_MAINTENANCE_FILE_SCAN_TIMEOUT_MS="120000"
IB_STALE_UPLOAD_MAX_AGE_MINUTES="60"
IB_STALE_UPLOAD_BATCH_LIMIT="100"
# Independent stale-upload health only alarms after max-age plus this extra grace window.
IB_STALE_UPLOAD_HEALTH_GRACE_MINUTES="30"
IB_STALE_UPLOAD_HEALTH_BATCH_LIMIT="50"
# Independent read-only email outbox health. Due deliveries/expired leases older than this grace period are unhealthy.
IB_NOTIFICATION_DELIVERY_HEALTH_GRACE_MINUTES="15"
IB_NOTIFICATION_DELIVERY_HEALTH_BATCH_LIMIT="50"
IB_FILE_SCAN_BATCH_LIMIT="1"
IB_FILE_SCAN_LEASE_SECONDS="120"
IB_FILE_SCAN_SOURCE_URL_TTL_SECONDS="180"
IB_FILE_SCAN_MAX_ATTEMPTS="5"
IB_FILE_SCAN_RETRY_BASE_SECONDS="60"
IB_FILE_SCAN_RETRY_MAX_SECONDS="3600"
# Independent read-only scanner backlog health. A due scan/expired lease older than this grace period is unhealthy.
IB_FILE_SCAN_HEALTH_GRACE_MINUTES="15"
IB_FILE_SCAN_HEALTH_BATCH_LIMIT="50"
IB_AI_AUDIT_GRACE_MINUTES="10"
IB_AI_AUDIT_BATCH_LIMIT="50"

# Yandex Object Storage — private bucket only.
IB_STORAGE_TARGET="staging"
IB_STAGING_STORAGE_BUCKET="private-iburo-staging-files"
IB_STAGING_STORAGE_ALLOWED_ORIGIN="https://staging-app.example.com"
IB_STAGING_STORAGE_ACCESS_KEY_ID="replace-with-staging-service-account-static-key-id"
YANDEX_STORAGE_BUCKET="private-iburo-staging-files"
YANDEX_STORAGE_ACCESS_KEY_ID="replace-with-staging-service-account-static-key-id"
YANDEX_STORAGE_SECRET_ACCESS_KEY="replace-with-staging-service-account-static-key-secret"