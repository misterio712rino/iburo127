DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

# Explicit guards for staging-only database verification/deploy tooling.
# These values must describe the same target encoded in DATABASE_URL.
IB_DB_TARGET="staging"
IB_STAGING_DATABASE_HOST="staging.pg.example.net"
IB_STAGING_DATABASE_NAME="iburo_staging"
IB_STAGING_DATABASE_USER="iburo_staging_user"
IB_STAGING_BETTER_AUTH_SCHEMA="public"

# Mutation confirmations are intentionally empty by default.
# Set only for the single staging operation being executed.
IB_STAGING_MIGRATION_CONFIRM=""
IB_STAGING_REFERENCE_SEED_CONFIRM=""
IB_STAGING_DEMO_SEED_CONFIRM=""

# Better Auth — generate a strong secret outside the repository.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="https://app.example.com"

# OpenAI Responses API for the server-side AI assistant.
OPENAI_API_KEY="replace-with-server-side-openai-api-key"
IB_AI_OPENAI_MODEL="gpt-5.6-terra"
IB_AI_OPENAI_REQUEST_TIMEOUT_MS="20000"
IB_AI_OPENAI_MAX_OUTPUT_TOKENS="1200"
IB_AI_RATE_LIMIT_PER_MINUTE="6"
IB_AI_RATE_LIMIT_PER_DAY="100"

# Active staging-only OpenAI provider smoke verification.
IB_AI_TARGET="staging"
IB_STAGING_OPENAI_MODEL="gpt-5.6-terra"
IB_STAGING_OPENAI_KEY_SHA256=""
IB_STAGING_AI_CONFIRM=""

# Staging HTTP authorization fixtures. Cookies must be short-lived staging sessions only.
IB_STAGING_BASE_URL="https://staging-app.example.com"
IB_STAGING_CLIENT_COOKIE=""
IB_STAGING_LAWYER_COOKIE=""
IB_STAGING_MANAGER_COOKIE=""
IB_STAGING_CLIENT_CASE_NUMBER="STAGE-CLIENT-001"
IB_STAGING_LAWYER_CASE_NUMBER="STAGE-LAWYER-001"
IB_STAGING_CLIENT_AI_CASE_NUMBER="STAGE-CLIENT-AI-001"
IB_STAGING_CLIENT_NO_AI_CASE_NUMBER="STAGE-CLIENT-NOAI-001"

# Bitrix24 internal CRM integration. PostgreSQL remains the source of truth.
# Use a dedicated least-privilege incoming webhook owned by a service/integration user.
BITRIX24_PORTAL_ORIGIN="https://iburo-staging.bitrix24.ru"
IB_BITRIX24_ALLOWED_HOST="iburo-staging.bitrix24.ru"
BITRIX24_WEBHOOK_USER_ID="17"
BITRIX24_WEBHOOK_SECRET="replace-with-staging-bitrix24-webhook-secret"
BITRIX24_REQUEST_TIMEOUT_MS="10000"

# Active read-only staging Bitrix24 verification guard.
# SHA-256 is the lowercase hex digest of the exact staging webhook secret.
# Confirmation for the single verification run:
# BITRIX-VERIFY:<hostname>:<user-id>:<secret-sha256>
IB_BITRIX24_TARGET="staging"
IB_STAGING_BITRIX24_PORTAL_ORIGIN="https://iburo-staging.bitrix24.ru"
IB_STAGING_BITRIX24_WEBHOOK_USER_ID="17"
IB_STAGING_BITRIX24_WEBHOOK_SECRET_SHA256=""
IB_STAGING_BITRIX24_CONFIRM=""

# Yandex Cloud Postbox — use a dedicated staging sender and service account/static key with postbox.sender.
YANDEX_POSTBOX_FROM_EMAIL="no-reply-staging@example.com"
YANDEX_POSTBOX_ACCESS_KEY_ID="replace-with-staging-postbox-static-key-id"
YANDEX_POSTBOX_SECRET_ACCESS_KEY="replace-with-staging-postbox-static-key-secret"
YANDEX_POSTBOX_REQUEST_TIMEOUT_MS="10000"

# Active staging Postbox simulator verification guard.
IB_EMAIL_TARGET="staging"
IB_STAGING_POSTBOX_FROM_EMAIL="no-reply-staging@example.com"
IB_STAGING_POSTBOX_ACCESS_KEY_ID="replace-with-staging-postbox-static-key-id"
IB_STAGING_POSTBOX_CONFIRM=""

# Private maintenance endpoint. Use an independent random secret (32+ chars).
IB_MAINTENANCE_SECRET="replace-with-an-independent-long-random-secret"
IB_STALE_UPLOAD_MAX_AGE_MINUTES="60"
IB_STALE_UPLOAD_BATCH_LIMIT="100"

# Yandex Object Storage — private bucket only.
IB_STORAGE_TARGET="staging"
IB_STAGING_STORAGE_BUCKET="private-iburo-staging-files"
IB_STAGING_STORAGE_ALLOWED_ORIGIN="https://staging-app.example.com"
YANDEX_STORAGE_BUCKET="private-iburo-staging-files"
YANDEX_STORAGE_ACCESS_KEY_ID="replace-with-service-account-static-key-id"
YANDEX_STORAGE_SECRET_ACCESS_KEY="replace-with-service-account-static-key-secret"
